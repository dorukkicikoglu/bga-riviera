{
  // option ids should be between 100 and 199
  // See https://en.doc.boardgamearena.com/Options_and_preferences:_gameoptions.json,_gamepreferences.json for more details
  /*
  EXAMPLE:

  "101": {
    "name": "Draft variant",
    "values": {
      "0": {
        "name": "No draft"
      },
      "1": {
        "name": "Draft",
        "description": "Add a draft at the beginning of the game"
        "tmdisplay": "Draft",
        "nobeginner": true
      }
    },
    "default": 0
  }
  */

  "100": {
    "name": "Reroll busting first-time rolls",
    "values": {
      "1": {
        "name": "On",
        "tmdisplay": "Up to 2 rerolls on first-roll bust",
        "description": "On the first roll of each round, the dice are rerolled (up to 2 times) if a player has no playable card."
      },
      "0": {
        "name": "Off",
        "description": "Physical game rules: the first roll is never rerolled."
      }
    },
    "default": 1
  }
}